# 【公开库防线】书稿库/备份/key 全目录排除,永不入库
data/

# --- 秘密与本地态 ---
# API key 只存在这里,绝不入库(设置页写入,git 忽略)
data/secrets.local.json

# Python
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Node
frontend/node_modules/
frontend/dist/

# 运行日志
*.log

# SQLite 临时文件(含 backups 子目录——守护快照写入时的 journal 是瞬态文件)
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/backups/*.db-journal
data/backups/*.db-wal
data/backups/*.db-shm
# 迁移/维护时的人工备份,不入仓
data/*.db.副本备份*

# 前端构建残留(重构建时改名的旧 dist)
frontend/dist.old-*/

# --- 素材库副本(原件在 E:\大项目终极anget\可用,内容一致,不重复入库) ---
可用/

# 嵌套副本(迁移包解压物/主本拷贝),不入库
soulspring/

# 办公软件锁文件(文件被 WPS/Word 打开时产生,不入库)
docs/.~lock.*
.mimosa/
data/books/

# 千章测评 runner 运行态(批次七①)
data/eval_thousand/

# 打包 spike 构建产物与独立环境(二期④;exe 留盘作物证,不入库)
packaging/spike/venv/
packaging/spike/dist/
packaging/spike/nuitka.log
packaging/spike/main.build/

